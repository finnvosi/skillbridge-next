// Prisma schema for SkillBridge
// Mirrors the domain model in @skillbridge/types, made relational for scale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  employer
  admin
  factory
  worker
}

enum ProjectStatus {
  open
  in_progress
  completed
  cancelled
}

enum ProjectType {
  internship
  part_time
  freelance
  full_time
}

enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

// Recruitment pipeline stage (distinct from the decision `status`).
enum ApplicationStage {
  applied
  screening
  shortlisted
  interview
  offer
  hired
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  name          String
  avatar        String?
  emailVerified Boolean  @default(false)
  suspended     Boolean   @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student   Student?
  employer  Employer?
  factory   Factory?
  worker    Worker?

  @@index([role])
}

model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  university    String?
  major         String?
  graduationYear Int?
  skills        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItems   PortfolioItem[]
  workExperiences  WorkExperience[]
  applications     Application[]
  aiResumes        AIResume[]
  careerRecs       CareerRecommendation[]
  certificates     Certificate[]   // <-- NEW
  interviews       Interview[]
  conversations    Conversation[]

  @@index([university])
}

model Employer {
  id          String    @id @default(cuid())
  userId      String    @unique
  companyName String
  industry    String?
  companySize Int       @default(0)
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  workExperiences WorkExperience[]
  interviews     Interview[]
  conversations  Conversation[]

  @@index([verified])
}

model Factory {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  location  String?
  capacity  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Worker {
  id        String   @id @default(cuid())
  userId    String   @unique
  skills    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String       @id @default(cuid())
  title          String
  description    String
  employerId     String
  type           ProjectType
  status         ProjectStatus @default(open)
  budget         Float?
  startDate      DateTime?
  endDate        DateTime?
  skillsRequired String[]
  location       String?
  remote         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employer        Employer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications    Application[]
  workExperiences WorkExperience[]
  interviews      Interview[]
  conversations   Conversation[]

  @@index([employerId])
  @@index([status])
  @@index([type])
}

model Interview {
  id           String            @id @default(cuid())
  employerId   String
  studentId    String
  projectId    String
  applicationId String?
  scheduledAt  DateTime
  durationMin  Int               @default(45)
  type         InterviewType     @default(online)
  status       InterviewStatus   @default(scheduled)
  location     String?
  meetingLink  String?
  notes        String?
  // Feedback
  rating       Int?
  strengths    String?
  concerns     String?
  recommendation InterviewRecommendation?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  employer   Employer   @relation(fields: [employerId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([employerId])
  @@index([studentId])
}

enum InterviewType {
  online
  phone
  onsite
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum InterviewRecommendation {
  strong_hire
  hire
  consider
  reject
}

// Lightweight employer <-> candidate messaging.
model Conversation {
  id        String   @id @default(cuid())
  employerId String
  studentId  String
  projectId  String?
  applicationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  employer   Employer    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([employerId])
  @@index([studentId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String // user id
  senderRole     String // 'employer' | 'student'
  body           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Application {
  id            String           @id @default(cuid())
  projectId      String
  studentId      String
  status         ApplicationStatus @default(pending)
  stage          ApplicationStage  @default(applied)
  coverLetter    String?
  proposedBudget Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interviews Interview[]
  conversations Conversation[]

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@index([status])
}

model Certificate {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  fileUrl     String
  fileKey     String   // path/key for storage backend
  mimeType    String
  fileSize    Int      // bytes
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([verified])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  imageUrl    String?
  projectUrl  String?
  technologies String[]
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model WorkExperience {
  id          String   @id @default(cuid())
  studentId   String
  projectId   String?
  employerId  String?
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  rating      Int?
  createdAt   DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employer Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([verified])
}

model AIResume {
  id        String   @id @default(cuid())
  studentId String
  content   String
  template  String   @default("modern")
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model CareerRecommendation {
  id                 String   @id @default(cuid())
  studentId          String
  recommendedProjectIds String[]
  recommendedSkills  String[]
  createdAt          DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
