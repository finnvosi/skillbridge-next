{
  "name": "api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "seed": "ts-node-dev --transpile-only scripts/seed.ts",
    "test": "bash scripts/contract-test.sh",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@skillbridge/config": "workspace:*",
    "@skillbridge/types": "workspace:*",
    "@skillbridge/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
